# ==============================================================================
# LNJPIT Semester I (Mathematics & Computing) - Environment Configuration
# ==============================================================================

# 1. Database Connection (PostgreSQL Production)
# Connect to your Supabase / Neon / AWS RDS / local PostgreSQL instance
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# 2. Supabase Auth Configuration (Required for /api/progress multi-user cloud sync)
# If unconfigured (empty), the application runs 100% locally and /api/progress returns 501.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 3. Optional: Live LLM AI Tutor Integration (/api/tutor)
# Gemini API Key (keep secret; only used on the server)
GEMINI_API_KEY=""
