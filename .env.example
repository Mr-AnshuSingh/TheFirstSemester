# ==============================================================================
# LNJPIT Semester I (Mathematics & Computing) - Environment Variables
# ==============================================================================

# Database Connection (PostgreSQL Production / Supabase / Neon / Local Postgres)
# Required only if using backend database persistence. App runs local-first with zero env vars.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Supabase Auth Configuration (Required for /api/progress multi-user cloud sync)
# If unconfigured, the application runs 100% locally and /api/progress returns 501.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Gemini API Key for /api/tutor academic problem solver (server-only)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If unset, the tutor automatically falls back to offline syllabus-grounded solutions.
GEMINI_API_KEY=""

# Optional: Upstash Redis for distributed rate limiting across serverless instances
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
